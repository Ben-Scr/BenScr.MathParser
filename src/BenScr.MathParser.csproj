<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>BenScr.MathParser</PackageId>
    <AssemblyName>BenScr.MathParser</AssemblyName>
    <RootNamespace>BenScr.MathParser</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Ben Schneider</Authors>
    <Description>Extensible mathematical expression parser with variables, custom functions, currency labels, localized decimal separators, and bounded parsing.</Description>
    <PackageTags>math;parser;calculator;expressions</PackageTags>
    <PackageProjectUrl>https://github.com/Ben-Scr/BenScr.MathParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ben-Scr/BenScr.MathParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../branding/BenScr_Icon_Master.png" Pack="true" PackagePath="/icon.png" />
  </ItemGroup>
</Project>
